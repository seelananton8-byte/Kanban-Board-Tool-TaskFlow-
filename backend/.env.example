PORT=5000
NODE_ENV=development

# Frontend origins
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# At least 32 characters each, and different from each other
JWT_ACCESS_SECRET=change-me-long-random-string-32-chars-min
JWT_REFRESH_SECRET=change-me-another-long-random-string-32

# Google sign-in (OAuth client ID)
GOOGLE_CLIENT_ID=

# email notifications via Brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=TaskFlow